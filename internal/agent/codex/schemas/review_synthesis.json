{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["should_escalate", "confidence"],
  "properties": {
    "should_escalate": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number"
    },
    "root_cause_title": {
      "type": "string"
    },
    "root_cause_summary": {
      "type": "string"
    },
    "recurring_symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "cycles", "affected_files"],
        "properties": {
          "description": {
            "type": "string"
          },
          "cycles": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "affected_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "why_individual_fixes_are_not_converging": {
      "type": "string"
    },
    "proposed_strategy": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirement_reinterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_kind",
        "conflicting_requirement",
        "platform_consistency_constraint",
        "preserved_safety_property",
        "corrected_invariant",
        "linearization_boundaries",
        "durability_boundaries"
      ],
      "properties": {
        "constraint_kind": {
          "type": "string",
          "enum": [
            "over_constrained",
            "internally_conflicting",
            "platform_non_atomic"
          ]
        },
        "conflicting_requirement": {
          "type": "string"
        },
        "platform_consistency_constraint": {
          "type": "string"
        },
        "preserved_safety_property": {
          "type": "string"
        },
        "corrected_invariant": {
          "type": "string"
        },
        "linearization_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "durability_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reason": {
      "type": "string"
    }
  }
}
